{
  "name": "@kuwork/backlog.md",
  "version": "1.52.0-CN",
  "type": "module",
  "module": "src/cli.ts",
  "files": [
    "scripts/*.cjs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "backlog": "scripts/cli.cjs"
  },
  "optionalDependencies": {
    "@kuwork/backlog.md-darwin-arm64": "*",
    "@kuwork/backlog.md-darwin-x64": "*",
    "@kuwork/backlog.md-linux-arm64": "*",
    "@kuwork/backlog.md-linux-x64": "*",
    "@kuwork/backlog.md-windows-arm64": "*",
    "@kuwork/backlog.md-windows-x64": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@clack/core": "1.2.0",
    "@clack/prompts": "1.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/bun": "1.3.12",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "28.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-router-dom": "5.3.3",
    "@uiw/react-markdown-preview": "5.2.0",
    "@uiw/react-md-editor": "4.1.0",
    "bun-plugin-tailwind": "^0.1.2",
    "commander": "14.0.3",
    "fuse.js": "7.3.0",
    "gray-matter": "4.0.3",
    "husky": "9.1.7",
    "install": "0.13.0",
    "jsdom": "29.0.2",
    "lint-staged": "16.4.0",
    "mammoth": "1.12.0",
    "mermaid": "11.16.1",
    "neo-neo-bblessed": "1.0.10",
    "picocolors": "1.1.1",
    "proper-lockfile": "4.1.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.14.1",
    "react-tooltip": "5.30.1",
    "tailwindcss": "4.2.2",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "scripts": {
    "test": "bun test",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check .",
    "check:types": "bunx tsc --noEmit",
    "prepare": "husky",
    "build": "bun scripts/build.ts",
    "cli": "bun src/cli.ts",
    "mcp": "bun src/cli.ts mcp start",
    "update-nix": "sh scripts/update-nix.sh",
    "benchmark:task-loading": "bun scripts/benchmark-task-loading.ts",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "lint-staged": {
    "package.json": [
      "biome check --write --files-ignore-unknown=true"
    ],
    "*.json": [
      "biome check --write --files-ignore-unknown=true"
    ],
    "src/**/*.{ts,js}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "author": "Alex Gavrilescu (https://github.com/MrLesk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLesk/Backlog.md.git"
  },
  "bugs": {
    "url": "https://github.com/MrLesk/Backlog.md/issues"
  },
  "homepage": "https://backlog.md",
  "keywords": [
    "cli",
    "markdown",
    "kanban",
    "task",
    "project-management",
    "backlog",
    "agents"
  ],
  "license": "MIT",
  "trustedDependencies": [
    "@biomejs/biome",
    "kuzu",
    "node-pty"
  ],
  "dependencies": {
    "d3": "^7.9.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "get-port": "^7.2.0",
    "kuzu": "^0.11.3"
  }
}
